# LiveKit Cloud (free tier is sufficient; the agent connects as a worker).
# Create a project at cloud.livekit.io -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Model stack ──────────────────────────────────────────────────────
# "local" (default) runs every model on this machine: no paid API, no provider
# account, nothing leaves the host. reproduce.sh starts the local LLM server.
# FDB_STACK=local

# Local LLM via any OpenAI-compatible server (Ollama by default).
# FDB_LLM_MODEL=qwen2.5:7b-instruct
# FDB_LLM_BASE_URL=http://localhost:11434/v1
# FDB_LLM_API_KEY=ollama

# Local STT (faster-whisper). Runs on CPU by default: CTranslate2 needs CUDA 12
# while the pinned torch ships CUDA 13. For GPU STT, first
#   pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# then set FDB_WHISPER_DEVICE=cuda. See README.
# FDB_WHISPER_MODEL=small.en     # large-v3 is better if you have the headroom
# FDB_WHISPER_DEVICE=cpu         # cuda | cpu | auto
# FDB_WHISPER_COMPUTE=auto       # float16 | int8 | auto
# FDB_WHISPER_BEAM=1

# Local TTS (Piper). reproduce.sh downloads the default voice.
# FDB_PIPER_VOICE=agent/piper/en_US-amy-medium.onnx

# Judge model for the optional --use-llm evaluation. Defaults to the local LLM
# server, so scoring costs nothing either. See README: these numbers are NOT
# comparable to the paper's gpt-4o-judged baseline.
# FDB_JUDGE_MODEL=qwen2.5:7b-instruct

# ── Controller / pipeline tuning ─────────────────────────────────────
# FDB_QUIET_WINDOW=0.9
# FDB_MIN_EP=0.6
# FDB_MAX_EP=2.0
# FDB_KEEP_ALIVE=1
# FDB_TURN_DETECTOR=1

# ── Optional: hosted comparison run (COSTS MONEY, not needed) ────────
# Set FDB_STACK=openai and provide a key to reproduce the hosted pipeline.
# FDB_STACK=openai
# OPENAI_API_KEY=
